---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';

const portImage = 'https://images.pexels.com/photos/14020705/pexels-photo-14020705.jpeg?auto=compress&cs=tinysrgb&w=1200&h=800&fit=crop';
const waLink = 'https://wa.me/989143403431?text=Hello%20StoneBuySell%2C%20I%20am%20interested%20in%20importing%20Iranian%20natural%20stone.%20Please%20send%20FOB%2FCIF%20pricing%20and%20specifications.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.stonebuysell.ir/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://www.stonebuysell.ir/contact/' },
  ],
};
---
<BaseLayout
  title="Contact StoneBuySell — Email & WhatsApp"
  description="Contact StoneBuySell for Iranian natural stone export inquiries. Email sanat.abr@gmail.com or WhatsApp 09143403431. Office in Urmia, West Azerbaijan, Iran."
  canonical="/contact/"
  image="/og-cover.jpg"
  schema={breadcrumb}
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav class="mb-6 text-sm text-stone-500">
      <a href="/" class="hover:text-stone-700">Home</a> <span class="mx-1">/</span> <span class="text-stone-700">Contact</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl">Contact StoneBuySell</h1>
    <p class="mt-4 text-lg text-stone-600">Reach us directly — no forms, no database. Just email or WhatsApp.</p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <!-- Email Card -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
        <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-stone-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-700"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h2 class="text-xl font-bold">Email</h2>
        <p class="mt-2 text-sm text-stone-600">Send us your project specifications, required stone types, and target volume.</p>
        <a href="mailto:sanat.abr@gmail.com" class="mt-3 inline-block font-semibold text-stone-700 underline hover:text-stone-900">sanat.abr@gmail.com</a>
      </div>

      <!-- WhatsApp Card -->
      <div class="rounded-2xl border border-green-200 bg-gradient-to-br from-green-50 to-emerald-50 p-6 shadow-sm">
        <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-[#25D366]">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.001-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        </div>
        <h2 class="text-xl font-bold">WhatsApp</h2>
        <p class="mt-2 text-sm text-stone-600">Fastest way to reach us. Send your requirements and get a quote.</p>
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-semibold text-stone-700 underline hover:text-stone-900">09143403431</a>
      </div>
    </div>

    <!-- Office Card -->
    <div class="mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
      <img
        src={portImage}
        alt="Logistics and port operations — StoneBuySell office in Urmia, Iran"
        width="1200"
        height="800"
        loading="lazy"
        decoding="async"
        class="h-56 w-full object-cover"
      />
      <div class="p-6">
        <h2 class="text-xl font-bold">Urmia Office</h2>
        <p class="mt-2 text-stone-600">StoneBuySell Export Desk<br />Urmia, West Azerbaijan Province, Iran</p>
        <p class="mt-2 text-sm text-stone-500">Office hours: Saturday–Thursday, 09:00–18:00 (Iran Standard Time)</p>
      </div>
    </div>

    <WhatsAppCTA message="Have a specific stone requirement? Send us the details on WhatsApp." />
  </section>
</BaseLayout>
