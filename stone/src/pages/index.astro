---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoneCard from '../components/StoneCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { getCollection } from 'astro:content';
import imageMap from '../data/imageMap.json';

const guides = (await getCollection('guides')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const blogs = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestGuides = guides.slice(0, 3);
const latestBlogs = blogs.slice(0, 2);

const heroImage = 'https://images.pexels.com/photos/15138925/pexels-photo-15138925.jpeg?auto=compress&cs=tinysrgb&w=1600&h=900&fit=crop';

const stoneCategories = [
  { name: 'Iranian Travertine', material: 'Travertine', description: 'Warm beige and silver tones, ideal for facades and flooring. Quarry-direct from Azarshahr and Takab.', priceNote: 'FOB Bandar Abbas from $180/ton', image: 'https://images.pexels.com/photos/34473055/pexels-photo-34473055.jpeg?auto=compress&cs=tinysrgb&w=400&h=260&fit=crop', alt: 'Iranian travertine quarry face — blocks ready for export' },
  { name: 'Persian Marble', material: 'Marble', description: 'Pietra Gray, White Crystal, Harsin marble — premium blocks and slabs for international projects.', priceNote: 'FOB Bandar Abbas from $250/ton', image: 'https://images.pexels.com/photos/4705843/pexels-photo-4705843.jpeg?auto=compress&cs=tinysrgb&w=400&h=260&fit=crop', alt: 'Iranian white marble slab — Persian marble for export' },
  { name: 'Iranian Granite', material: 'Granite', description: 'Red, pink, and gray granite blocks from Natanz and Urmia quarries for construction and monuments.', priceNote: 'FOB Bandar Abbas from $200/ton', image: 'https://images.pexels.com/photos/39259838/pexels-photo-39259838.jpeg?auto=compress&cs=tinysrgb&w=400&h=260&fit=crop', alt: 'Iranian granite quarry — blocks ready for wholesale export' },
  { name: 'Iranian Onyx', material: 'Onyx', description: 'Translucent green and honey onyx blocks — rare decorative stone for luxury interiors.', priceNote: 'FOB Bandar Abbas from $800/ton', image: 'https://images.pexels.com/photos/28288786/pexels-photo-28288786.jpeg?auto=compress&cs=tinysrgb&w=400&h=260&fit=crop', alt: 'Polished Iranian onyx stone — decorative block for export' },
  { name: 'Iranian Limestone', material: 'Limestone', description: 'Cream and beige limestone blocks for cladding, paving, and architectural restoration.', priceNote: 'FOB Bandar Abbas from $150/ton', image: 'https://images.pexels.com/photos/6634148/pexels-photo-6634148.jpeg?auto=compress&cs=tinysrgb&w=400&h=260&fit=crop', alt: 'Iranian limestone texture — blocks for export' },
  { name: 'Crystal Stone', material: 'Crystal', description: 'Neyriz and Dehbid crystal marble — high-purity white stone with crystalline structure.', priceNote: 'FOB Bandar Abbas from $300/ton', image: 'https://images.pexels.com/photos/3847496/pexels-photo-3847496.jpeg?auto=compress&cs=tinysrgb&w=400&h=260&fit=crop', alt: 'Iranian crystal marble — white stone blocks for export' },
];

const trustFeatures = [
  { title: 'Quarry-Direct Supply', desc: 'No middlemen. We source directly from quarries in Urmia, Azarshahr, and Natanz.' },
  { title: 'FOB Bandar Abbas', desc: 'Containerized shipping from Iran\'s largest port to your destination worldwide.' },
  { title: 'Quality Inspection', desc: 'Every shipment inspected for block quality, dimensions, and consistency before loading.' },
  { title: 'Full Export Documentation', desc: 'Certificate of origin, bill of lading, packing list, and customs clearance handled.' },
  { title: '20+ Stone Types', desc: 'Travertine, marble, granite, onyx, limestone, and crystal — blocks and slabs.' },
  { title: 'WhatsApp Direct', desc: 'Skip the forms. Message 09143403431 for quotes, specs, and shipment tracking.' },
];

function getImg(slug: string) {
  const entry = (imageMap as Record<string, { src: string; alt: string }>)[slug];
  return entry ?? { src: '', alt: '' };
}
function readTime(words: number) {
  return `${Math.max(3, Math.round(words / 200))} min read`;
}

const productSchema = stoneCategories.map((cat) => ({
  '@type': 'Product',
  name: cat.name,
  material: cat.material,
  brand: { '@type': 'Brand', name: 'StoneBuySell' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
}));

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': productSchema,
};
---
<BaseLayout
  title="Iranian Natural Stone, Quarry-Direct Export"
  description="StoneBuySell exports Iranian travertine, marble, granite, onyx, limestone and crystal stone blocks and slabs — quarry-direct, FOB Bandar Abbas, to your project worldwide."
  canonical="/"
  image="/og-cover.jpg"
  schema={pageSchema}
>
  <!-- Hero -->
  <section class="relative flex items-center overflow-hidden" style="min-height: 520px;">
    <img
      src={heroImage}
      alt="Iranian natural stone quarry — travertine blocks ready for export from Urmia to Bandar Abbas"
      width="1600"
      height="900"
      loading="eager"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-stone-900/85 via-stone-900/60 to-stone-900/30"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="max-w-2xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-stone-300">StoneBuySell — Urmia Export Desk</p>
        <h1 class="text-3xl font-bold leading-tight text-white sm:text-4xl md:text-5xl">
          Iranian Natural Stone, Quarry-Direct from Urmia to Your Project
        </h1>
        <p class="mt-5 text-base leading-relaxed text-stone-200 sm:text-lg">
          Travertine, marble, granite, onyx, limestone and crystal — blocks and slabs sourced directly from Iranian quarries and shipped FOB Bandar Abbas to factories, importers, and project contractors worldwide.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="https://wa.me/989143403431?text=Hello%20StoneBuySell%2C%20I%20am%20interested%20in%20importing%20Iranian%20natural%20stone.%20Please%20send%20FOB%2FCIF%20pricing%20and%20specifications."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-bold text-white shadow-lg transition-transform hover:scale-105"
          >
            Request FOB Quote via WhatsApp
          </a>
          <a
            href="/guides/"
            class="inline-flex items-center gap-2 rounded-full border border-stone-400 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-white hover:text-stone-900"
          >
            Read Export Guides
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stone Categories -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mb-10 text-center">
      <h2 class="text-2xl sm:text-3xl">Iranian Natural Stone Categories</h2>
      <p class="mx-auto mt-3 max-w-2xl text-stone-600">Quarry-direct blocks and slabs, FOB Bandar Abbas. Prices are indicative per ton — request a live quote for current rates and specifications.</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {stoneCategories.map((cat) => (
        <StoneCard
          name={cat.name}
          material={cat.material}
          description={cat.description}
          priceNote={cat.priceNote}
          image={cat.image}
          alt={cat.alt}
        />
      ))}
    </div>
  </section>

  <!-- Trust Features -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-10 text-center">
        <h2 class="text-2xl sm:text-3xl">Why Importers Choose StoneBuySell</h2>
        <p class="mx-auto mt-3 max-w-2xl text-stone-600">Six reasons stone buyers and project contractors trust our Urmia export desk for reliable, documented shipments.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {trustFeatures.map((f) => (
          <div class="rounded-xl border border-stone-200 p-6 transition-shadow hover:shadow-md">
            <h3 class="text-lg font-bold text-stone-900">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Guides + Blogs -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mb-10 text-center">
      <h2 class="text-2xl sm:text-3xl">Latest Export Guides &amp; Articles</h2>
      <p class="mx-auto mt-3 max-w-2xl text-stone-600">Practical, step-by-step guides on importing Iranian natural stone — documentation, pricing, Incoterms, shipping, and quality control.</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latestGuides.map((g) => {
        const img = getImg(g.slug);
        return (
          <ArticleCard
            href={`/guides/${g.slug}/`}
            title={g.data.title}
            description={g.data.description}
            image={img.src}
            alt={img.alt}
            readTime="Guide"
          />
        );
      })}
      {latestBlogs.map((b) => {
        const img = getImg(b.slug);
        return (
          <ArticleCard
            href={`/blog/${b.slug}/`}
            title={b.data.title}
            description={b.data.description}
            image={img.src}
            alt={img.alt}
            readTime="Blog"
          />
        );
      })}
    </div>
    <div class="mt-8 text-center">
      <a href="/guides/" class="inline-flex items-center gap-1 text-sm font-semibold text-stone-700 hover:text-stone-900">Browse all guides &rarr;</a>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <WhatsAppCTA />
  </div>
</BaseLayout>
