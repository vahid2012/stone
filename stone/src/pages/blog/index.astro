---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import imageMap from '../../data/imageMap.json';

const blogs = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getImg(slug: string) {
  const entry = (imageMap as Record<string, { src: string; alt: string }>)[slug];
  return entry ?? { src: '', alt: '' };
}

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.stonebuysell.ir/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.stonebuysell.ir/blog/' },
  ],
};
---
<BaseLayout
  title="StoneBuySell Blog — Iranian Stone Industry Insights"
  description="Articles on the Iranian stone industry, market trends, shipping, port logistics, and architectural stone facade trends for 2026 and beyond."
  canonical="/blog/"
  image="/og-cover.jpg"
  schema={breadcrumb}
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav class="mb-6 text-sm text-stone-500">
      <a href="/" class="hover:text-stone-700">Home</a> <span class="mx-1">/</span> <span class="text-stone-700">Blog</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl">StoneBuySell Blog</h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-600">Insights on the Iranian stone industry, market trends, shipping logistics, and architectural stone specifications.</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {blogs.map((b) => {
        const img = getImg(b.slug);
        return (
          <ArticleCard
            href={`/blog/${b.slug}/`}
            title={b.data.title}
            description={b.data.description}
            image={img.src}
            alt={img.alt}
            readTime="Blog"
          />
        );
      })}
    </div>
  </section>
</BaseLayout>
