---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaJsonLd from '../../components/SchemaJsonLd.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import imageMap from '../../data/imageMap.json';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}
const { guide } = Astro.props;
const { Content } = await guide.render();
const { data } = guide;

const site = 'https://www.stonebuysell.ir';
const canonical = `/guides/${guide.slug}/`;
const imgEntry = (imageMap as Record<string, { src: string; alt: string }>)[guide.slug] ?? { src: '', alt: '' };
const articleImage = imgEntry.src;

const author = {
  '@type': 'Person',
  name: 'StoneBuySell Export Desk',
  jobTitle: 'Natural Stone Export Specialist',
  worksFor: { '@id': `${site}/#organization` },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  author: author,
  publisher: { '@id': `${site}/#organization` },
  datePublished: data.date.toISOString(),
  dateModified: data.date.toISOString(),
  mainEntityOfPage: `${site}${canonical}`,
  image: articleImage,
  citation: ['https://www.intracen.org/', 'https://comtradeplus.un.org/', 'https://en.wikipedia.org/wiki/Incoterms'],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: data.howToName,
  step: data.steps.map((step, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: step.name,
    text: step.text,
  })),
};

const faqSchema = data.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
} : null;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/guides/` },
    { '@type': 'ListItem', position: 3, name: data.title, item: `${site}${canonical}` },
  ],
};

const imageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  url: articleImage,
  contentUrl: articleImage,
  caption: data.imageAlt,
};

const schemas = [articleSchema, howToSchema, breadcrumb, imageSchema];
if (faqSchema) schemas.push(faqSchema);
---
<BaseLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  image={imgEntry.src ? articleImage : '/og-cover.jpg'}
  schema={schemas}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav class="mb-6 text-sm text-stone-500">
      <a href="/" class="hover:text-stone-700">Home</a>
      <span class="mx-1">/</span>
      <a href="/guides/" class="hover:text-stone-700">Guides</a>
      <span class="mx-1">/</span>
      <span class="text-stone-700">{data.title}</span>
    </nav>

    <h1 class="text-3xl leading-tight sm:text-4xl">{data.title}</h1>
    <p class="mt-3 text-sm text-stone-500">
      Published {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · StoneBuySell Export Desk
    </p>

    <img
      src={articleImage}
      alt={data.imageAlt}
      width="1200"
      height="800"
      loading="eager"
      decoding="async"
      class="mt-6 w-full rounded-2xl object-cover shadow-lg"
      style="max-height: 420px;"
    />

    <div class="prose-guide mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
