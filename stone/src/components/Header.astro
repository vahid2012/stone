---
const nav = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Guides', href: '/guides/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Collaboration', href: '/collaboration/' },
  { label: 'Contact', href: '/contact/' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-stone-200 bg-white/95 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-stone-900">
      <span class="inline-block h-8 w-8 rounded bg-stone-800"></span>
      StoneBuySell
    </a>
    <ul class="hidden items-center gap-6 text-sm font-medium md:flex">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'text-stone-600 hover:text-stone-900',
              path === item.href && 'text-stone-900 font-semibold border-b-2 border-stone-800',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <details class="relative md:hidden">
      <summary class="flex cursor-pointer items-center rounded p-2 text-stone-700">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </summary>
      <ul class="absolute right-0 mt-2 w-48 rounded-lg border border-stone-200 bg-white py-2 shadow-lg">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="block px-4 py-2 text-sm text-stone-600 hover:bg-stone-100 hover:text-stone-900">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
