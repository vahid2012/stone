---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import imageMap from '../../data/imageMap.json';

const guides = (await getCollection('guides')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getImg(slug: string) {
  const entry = (imageMap as Record<string, { src: string; alt: string }>)[slug];
  return entry ?? { src: '', alt: '' };
}

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.stonebuysell.ir/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://www.stonebuysell.ir/guides/' },
  ],
};
---
<BaseLayout
  title="Iranian Natural Stone Export Guides"
  description="Step-by-step guides on importing Iranian natural stone — documentation, FOB pricing, Incoterms, shipping, quality inspection, customs clearance, and supplier verification."
  canonical="/guides/"
  image="/og-cover.jpg"
  schema={breadcrumb}
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav class="mb-6 text-sm text-stone-500">
      <a href="/" class="hover:text-stone-700">Home</a> <span class="mx-1">/</span> <span class="text-stone-700">Guides</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl">Iranian Natural Stone Export Guides</h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-600">Comprehensive, step-by-step guides covering every aspect of importing Iranian natural stone — from FOB pricing to documentation, shipping, quality control, and supplier verification.</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {guides.map((g) => {
        const img = getImg(g.slug);
        return (
          <ArticleCard
            href={`/guides/${g.slug}/`}
            title={g.data.title}
            description={g.data.description}
            image={img.src}
            alt={img.alt}
            readTime="Guide"
          />
        );
      })}
    </div>
  </section>
</BaseLayout>
