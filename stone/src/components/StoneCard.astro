---
interface Props {
  name: string;
  material: string;
  description: string;
  priceNote: string;
  image: string;
  alt: string;
}
const { name, material, description, priceNote, image, alt } = Astro.props;
---
<div class="group overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition-all duration-300 hover:shadow-xl">
  <div class="overflow-hidden">
    <img
      src={image}
      alt={alt}
      width="400"
      height="260"
      loading="lazy"
      decoding="async"
      class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    <span class="inline-block rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-stone-600">{material}</span>
    <h3 class="mt-3 text-lg font-bold text-stone-900">{name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-stone-600">{description}</p>
    <p class="mt-3 text-sm font-semibold text-stone-700">{priceNote}</p>
  </div>
</div>
