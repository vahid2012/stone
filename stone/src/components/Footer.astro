        <div class="flex items-center gap-2 text-xl font-bold text-white">
          <span class="inline-block h-7 w-7 rounded bg-stone-600"></span>
          StoneBuySell
        </div>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-stone-400">
          Quarry-direct exporter of Iranian travertine, marble, granite, onyx, limestone and crystal stone blocks and slabs for international projects.
        </p>
        <p class="mt-4 text-sm text-stone-400">
          <a href="mailto:sanat.abr@gmail.com" class="hover:text-white">sanat.abr@gmail.com</a><br />
          WhatsApp: <a href="https://wa.me/989143403431" target="_blank" rel="noopener noreferrer" class="hover:text-white">09143403431</a><br />
          Urmia, West Azerbaijan Province, Iran
        </p>
      </div>
      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">Pages</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/collaboration/" class="hover:text-white">Collaboration</a></li>
          <li><a href="/contact/" class="hover:text-white">Contact</a></li>
          <li><a href="/guides/" class="hover:text-white">Guides</a></li>
