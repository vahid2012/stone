---
interface Props {
  href: string;
  title: string;
  description: string;
  image: string;
  alt: string;
  readTime?: string;
}
const { href, title, description, image, alt, readTime } = Astro.props;
---
<a href={href} class="group flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition-all duration-300 hover:shadow-xl">
  <div class="overflow-hidden">
    <img
      src={image}
      alt={alt}
      width="400"
      height="230"
      loading="lazy"
      decoding="async"
      class="h-44 w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-bold leading-snug text-stone-900 group-hover:text-stone-700">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{description}</p>
    {readTime && (
      <p class="mt-3 text-xs font-medium uppercase tracking-wide text-stone-400">{readTime}</p>
    )}
  </div>
</a>
