---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';

const collabImage = 'https://images.pexels.com/photos/6918529/pexels-photo-6918529.jpeg?auto=compress&cs=tinysrgb&w=1200&h=800&fit=crop';
const waLink = 'https://wa.me/989143403431?text=Hello%20StoneBuySell%2C%20I%20would%20like%20to%20discuss%20a%20partnership%20opportunity.';

const models = [
  { title: 'Distributor', desc: 'Become a regional distributor for Iranian stone. We supply blocks and slabs at competitive FOB rates, with consistent quality and documentation support.' },
  { title: 'Factory Partner', desc: 'Stone processing factories can source raw blocks directly from our quarries. We match block dimensions and grades to your production line.' },
  { title: 'Trading Partner', desc: 'Trading companies can leverage our quarry network and export documentation to serve their own clients worldwide.' },
  { title: 'Project Sourcing', desc: 'Contractors and developers can source project-specific stone — from travertine facades to marble interiors — with quality-controlled shipments.' },
];

const benefits = [
  'Direct quarry access — no middlemen, better margins',
  'Full export documentation and customs clearance support',
  'Quality inspection reports before every shipment',
  'FOB Bandar Abbas — access to global shipping routes',
  'Flexible order sizes — from single containers to project volumes',
  'WhatsApp-based communication for fast, direct coordination',
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.stonebuysell.ir/' },
    { '@type': 'ListItem', position: 2, name: 'Collaboration', item: 'https://www.stonebuysell.ir/collaboration/' },
  ],
};
---
<BaseLayout
  title="Work With Us — همکاری با ما"
  description="Partner with StoneBuySell as a distributor, factory, trading partner, or project sourcing client. Quarry-direct Iranian natural stone with full export support."
  canonical="/collaboration/"
  image="/og-cover.jpg"
  schema={breadcrumb}
>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <nav class="mb-6 text-sm text-stone-500">
      <a href="/" class="hover:text-stone-700">Home</a> <span class="mx-1">/</span> <span class="text-stone-700">Collaboration</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl">Work With Us / همکاری با ما</h1>
    <p class="mt-4 text-lg text-stone-600">Partnership models for distributors, factories, trading companies, and project contractors.</p>

    <img
      src={collabImage}
      alt="Business handshake — StoneBuySell partnership for Iranian natural stone export"
      width="1200"
      height="800"
      loading="eager"
      decoding="async"
      class="mt-8 w-full rounded-2xl object-cover shadow-lg"
      style="max-height: 400px;"
    />

    <div class="mt-10">
      <h2 class="text-2xl">Partnership Models</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {models.map((m) => (
          <div class="rounded-xl border border-stone-200 bg-white p-6 transition-shadow hover:shadow-md">
            <h3 class="text-lg font-bold text-stone-900">{m.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-10">
      <h2 class="text-2xl">Benefits of Partnering</h2>
      <ul class="mt-6 space-y-3">
        {benefits.map((b) => (
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0 text-green-600"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-stone-700">{b}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-10 rounded-2xl border border-green-200 bg-gradient-to-br from-green-50 to-emerald-50 p-8 text-center shadow-sm">
      <h2 class="text-2xl">Ready to Partner?</h2>
      <p class="mt-3 text-stone-600">Message us on WhatsApp to discuss your partnership goals.</p>
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-bold text-white shadow-lg transition-transform hover:scale-105"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.001-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        Contact us on WhatsApp
      </a>
      <p class="mt-3 text-xs text-stone-500">Direct to 09143403431 — no forms, no database.</p>
    </div>
  </section>
</BaseLayout>
